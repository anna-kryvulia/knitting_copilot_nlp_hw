# Copy to .env and fill in. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free models (check https://openrouter.ai/collections/free-models — the list changes).
# App model: needs tool calling + JSON output.
LLM_MODEL=google/gemma-4-31b-it:free
# Comma-separated, tried in order when the main model is rate-limited or fails.
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free
# Judge for evals: a different model family than LLM_MODEL (avoids self-preference bias).
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Local embedding model for retrieval (runs on CPU, no API needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# 1 = cache LLM responses in .cache/llm (reproducible, rate-limit friendly evals); 0 = always call
LLM_CACHE=1
LLM_MAX_RETRIES=4
LLM_TIMEOUT_S=60

DB_PATH=data/knit.db

# Ravelry API (free developer account: https://www.ravelry.com/pro/developer). Used only by data scripts.
RAVELRY_USERNAME=
RAVELRY_PASSWORD=
