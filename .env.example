# Copy to .env and fill in. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free models (check https://openrouter.ai/collections/free-models — the list changes).
# App model: needs tool calling + JSON output.
# Chosen by scripts/compare_parser_models.py (results/parser_model_comparison.json): exact on the
# test patterns in 32-57 s; Gemma 4 free models were rate-limited on every attempt.
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Comma-separated, tried in order when the main model is rate-limited or fails.
LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,dots-studio/dots-3-note-preview:free
# Judge for evals: a different model family than LLM_MODEL (avoids self-preference bias).
JUDGE_MODEL=dots-studio/dots-3-note-preview:free

# Local embedding model for retrieval (runs on CPU, no API needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# 1 = cache LLM responses in .cache/llm (reproducible, rate-limit friendly evals); 0 = always call
LLM_CACHE=1
LLM_MAX_RETRIES=4
LLM_TIMEOUT_S=60
# Hard limit for reading one pattern with the LLM (all models, retries and the repair attempt together)
PARSE_TIME_BUDGET_S=60

DB_PATH=data/knit.db

# Ravelry API (free developer account: https://www.ravelry.com/pro/developer). Used only by data scripts.
RAVELRY_USERNAME=
RAVELRY_PASSWORD=

# Optional: any other OpenAI-compatible provider instead of OpenRouter (free tiers: Groq, Google AI Studio, Cerebras).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# The judge can use a different provider (it must be a different model family than LLM_MODEL):
# JUDGE_BASE_URL=https://openrouter.ai/api/v1   (JUDGE_API_KEY then defaults to OPENROUTER_API_KEY)
# JUDGE_API_KEY=
# Thinking models (Gemini 3.x): hidden reasoning counts against max_tokens and long JSON gets cut off; low keeps it short.
# LLM_REASONING_EFFORT=low
